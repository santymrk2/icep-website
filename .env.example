# Supabase: Project Settings → API Keys (Project URL + secret key, NUNCA la publishable/anon)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Panel /jvns/admin. Contraseña mínima 16 caracteres: generá una con `openssl rand -base64 24`
JVNS_ADMIN_USER=admin
JVNS_ADMIN_PASSWORD=

# Opcional: WhatsApp de respaldo si falla el envío del formulario (formato 549XXXXXXXXXX)
PUBLIC_WHATSAPP=
