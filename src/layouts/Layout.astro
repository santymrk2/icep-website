---
import "../styles/global.css";
import "@fontsource/merriweather";
import "@fontsource-variable/noto-sans";
import Footer from "../components/Footer.tsx";
import Analytics from "@vercel/analytics/astro";
import Header from "../components/Navbar.tsx";
import LoadingScreen from "../components/LoadingScreen.tsx";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Iglesia Cristiana Evangélica en Pilar - Sitio Oficial",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171717" />

    <!-- Force dark mode — clear any stale theme from localStorage -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add("dark");
        document.documentElement.classList.remove("light");
        localStorage.removeItem("theme");
      })();
    </script>

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="ICEP" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Sin JS el loader (renderizado en el servidor) taparía la página para siempre. -->
    <noscript><style>.loading-screen { display: none !important; }</style></noscript>
    <Analytics />
  </head>

  <body
    class="min-h-screen bg-neutral-900 text-white overflow-x-hidden"
  >
    <LoadingScreen client:load />
    <Header client:load />
    <main>
      <slot />
    </main>
    <Footer client:visible />

    <script>
      import { initSmoothScroll } from "../lib/smooth-scroll";
      initSmoothScroll();
    </script>
  </body>
</html>
