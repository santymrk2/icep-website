---
export const prerender = true;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pontifex | ICEP Jóvenes</title>
  <meta name="description" content="Pontifex - Ministerio de Jóvenes de la Iglesia Cristiana Evangélica Pilar. Próximamente." />

  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;800&display=swap" rel="stylesheet" />

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #000;
      font-family: system-ui, -apple-system, sans-serif;
    }

    /* Shader canvas — full viewport behind everything */
    #shader-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      z-index: 0;
    }

    /* Content overlay */
    .content {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      padding: 2rem;
      text-align: center;
    }

    .logo {
      max-width: 480px;
      width: 85vw;
      height: auto;
      filter: drop-shadow(0 0 60px rgba(248, 75, 0, 0.35));
    }

    .proximamente {
      color: rgba(255, 255, 255, 0.7);
      font-family: 'Montserrat', sans-serif;
      font-size: clamp(0.875rem, 2vw, 1.25rem);
      font-weight: 300;
      letter-spacing: 0.5em;
      text-transform: uppercase;
    }

    .instagram-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      color: #fff;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 400;
      padding: 0.875rem 2rem;
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 9999px;
      transition: all 0.3s ease;
      backdrop-filter: blur(8px);
      background: rgba(255, 255, 255, 0.05);
    }

    .instagram-btn:hover {
      border-color: #F84B00;
      color: #F84B00;
      background: rgba(248, 75, 0, 0.08);
      transform: scale(1.05);
    }

    .instagram-btn svg {
      width: 1.25rem;
      height: 1.25rem;
      fill: currentColor;
      transition: fill 0.3s ease;
    }

    /* Mobile adjustments */
    @media (max-width: 640px) {
      .logo { max-width: 300px; }
      .instagram-btn { padding: 0.75rem 1.5rem; font-size: 1rem; }
    }
  </style>
</head>
<body>
  <!-- WebGL Shader Canvas -->
  <canvas id="shader-canvas"></canvas>

  <script is:inline>
    (function () {
      var canvas = document.getElementById("shader-canvas");
      var dpr = Math.min(window.devicePixelRatio || 1, 2);

      function syncSize() {
        var w = canvas.clientWidth || 1280;
        var h = canvas.clientHeight || 720;
        var bw = Math.round(w * dpr);
        var bh = Math.round(h * dpr);
        if (canvas.width !== bw || canvas.height !== bh) {
          canvas.width = bw;
          canvas.height = bh;
        }
      }
      if (typeof ResizeObserver !== "undefined") {
        new ResizeObserver(syncSize).observe(canvas);
      }
      syncSize();

      var gl = canvas.getContext("webgl", { antialias: true, alpha: false }) || canvas.getContext("experimental-webgl");
      if (!gl) return;

      var vs = [
        "attribute vec2 a_position;",
        "varying vec2 v_texCoord;",
        "void main() {",
        "  v_texCoord = a_position * 0.5 + 0.5;",
        "  gl_Position = vec4(a_position, 0.0, 1.0);",
        "}"
      ].join("\n");

      var fs = [
        "precision highp float;",
        "varying vec2 v_texCoord;",
        "uniform float u_time;",
        "uniform vec2 u_resolution;",
        "uniform vec2 u_mouse;",
        "",
        "void main() {",
        "    vec2 uv = v_texCoord;",
        "    vec2 aspect = vec2(u_resolution.x / u_resolution.y, 1.0);",
        "    vec2 uvA = uv * aspect;",
        "",
        "    vec3 orange = vec3(0.973, 0.294, 0.0);",
        "    vec3 orangeLight = vec3(1.0, 0.45, 0.05);",
        "    vec3 orangeDim = vec3(0.7, 0.18, 0.0);",
        "    vec3 black = vec3(0.0);",
        "",
        "    float t = u_time * 0.4;",
        "    float totalLine = 0.0;",
        "    vec3 lineColor = black;",
        "",
        "    vec2 zoomUV = uvA * 2.5;",
        "",
        "    for (float i = 0.0; i < 12.0; i++) {",
        "        float fi = i / 12.0;",
        "        float yPos = fi * 1.2 - 0.1;",
        "        float speed = 0.6 + fi * 0.5;",
        "        float freq = 3.0 + fi * 5.0;",
        "        float amp = 0.03 + fi * 0.02;",
        "",
        "        float wave1 = sin(zoomUV.x * freq + t * speed) * amp;",
        "        float wave2 = sin(zoomUV.x * freq * 1.7 + t * speed * 0.7 + 1.3) * amp * 0.4;",
        "        float wave3 = cos(zoomUV.x * freq * 0.5 + t * speed * 1.3 + 2.7) * amp * 0.2;",
        "        float y = yPos + wave1 + wave2 + wave3;",
        "",
        "        float thickness = 0.001 + 0.0015 * (1.0 - fi);",
        "        float line = smoothstep(thickness + 0.001, thickness, abs(uv.y - y));",
        "",
        "        float glowRadius = 0.025 + fi * 0.035;",
        "        float glow = smoothstep(glowRadius, 0.0, abs(uv.y - y)) * 0.12;",
        "",
        "        float intensity = line + glow;",
        "        vec3 col = mix(orangeDim, orangeLight, fi);",
        "        col = mix(col, orange, line * 0.6);",
        "",
        "        totalLine += intensity;",
        "        lineColor += col * intensity;",
        "    }",
        "",
        "    float md = distance(uvA, u_mouse / vec2(u_resolution.y, u_resolution.y) * aspect);",
        "    float mGlow = smoothstep(0.5, 0.0, md) * 0.15;",
        "    lineColor += orange * mGlow;",
        "    totalLine += mGlow;",
        "",
        "    float vignette = 1.0 - smoothstep(0.4, 1.4, length(uv - 0.5) * 1.8);",
        "",
        "    vec3 finalColor = mix(black, lineColor, min(totalLine, 1.0));",
        "    finalColor *= 0.85 + vignette * 0.15;",
        "",
        "    gl_FragColor = vec4(finalColor, 1.0);",
        "}"
      ].join("\n");

      function createShader(type, src) {
        var s = gl.createShader(type);
        gl.shaderSource(s, src);
        gl.compileShader(s);
        return s;
      }

      var prog = gl.createProgram();
      gl.attachShader(prog, createShader(gl.VERTEX_SHADER, vs));
      gl.attachShader(prog, createShader(gl.FRAGMENT_SHADER, fs));
      gl.linkProgram(prog);
      gl.useProgram(prog);

      var buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);

      var pos = gl.getAttribLocation(prog, "a_position");
      gl.enableVertexAttribArray(pos);
      gl.vertexAttribPointer(pos, 2, gl.FLOAT, false, 0, 0);

      var uTime = gl.getUniformLocation(prog, "u_time");
      var uRes = gl.getUniformLocation(prog, "u_resolution");
      var uMouse = gl.getUniformLocation(prog, "u_mouse");

      var mouse = { x: 0, y: 0 };

      window.addEventListener("mousemove", function (event) {
        var rect = canvas.getBoundingClientRect();
        if (rect.width && rect.height) {
          mouse.x = event.clientX - rect.left;
          mouse.y = event.clientY - rect.top;
        }
      });

      function render(t) {
        if (typeof ResizeObserver === "undefined") syncSize();
        gl.viewport(0, 0, canvas.width, canvas.height);
        if (uTime) gl.uniform1f(uTime, t * 0.001);
        if (uRes) gl.uniform2f(uRes, canvas.width, canvas.height);
        if (uMouse) gl.uniform2f(uMouse, mouse.x * dpr, mouse.y * dpr);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        requestAnimationFrame(render);
      }

      render(0);
    })();
  </script>

  <!-- Content Overlay -->
  <div class="content">
    <p class="proximamente">Próximamente</p>

    <img
      src="/assets/ministerios/jovenes/Imagotipo_white.svg"
      alt="Pontifex"
      class="logo"
    />

    <a
      href="https://instagram.com/jovenes_icep"
      target="_blank"
      rel="noopener noreferrer"
      class="instagram-btn"
    >
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.254 1.216.598 1.772 1.153a4.908 4.908 0 0 1 1.153 1.772c.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.218 1.79-.465 2.428a4.883 4.883 0 0 1-1.153 1.772 4.915 4.915 0 0 1-1.772 1.153c-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.218-2.428-.465a4.89 4.89 0 0 1-1.772-1.153 4.904 4.904 0 0 1-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.066.217-1.79.465-2.428a4.88 4.88 0 0 1 1.153-1.772A4.897 4.897 0 0 1 5.45 2.525c.638-.248 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm6.5-.25a1.25 1.25 0 0 0-2.5 0 1.25 1.25 0 0 0 2.5 0zM12 9a3 3 0 1 1 0 6 3 3 0 0 1 0-6z"/>
      </svg>
      @jovenes_icep
    </a>
  </div>
</body>
</html>
